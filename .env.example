# Copy to .env.local for `npm run dev`, and add the same variables in your host's dashboard
# (Vercel: Project → Settings → Environment Variables. Netlify: Site → Environment variables).
# See SETUP.md for where each value comes from.

# ── Browser (public: anything starting with VITE_ ends up in the page code) ──
VITE_WAITLIST_ENDPOINT=/api/waitlist
# Optional Cloudflare Turnstile site key (bot check). Leave empty to turn it off.
VITE_TURNSTILE_SITE_KEY=

# ── Server only (secret: never prefix these with VITE_) ──
SITE_URL=https://proofy.app
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# New "sb_secret_…" key, or put a legacy key in SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
MAIL_FROM=Proofy <hello@mail.proofy.app>
MAIL_REPLY_TO=
# Any long random string. Used to hash IP addresses for rate limiting.
IP_HASH_SALT=

# Optional
DOUBLE_OPT_IN=true
TURNSTILE_SECRET_KEY=
# Other sites allowed to post to the API, comma-separated (SITE_URL is always allowed).
ALLOWED_ORIGINS=
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600
RESEND_COOLDOWN_SECONDS=600
